{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (!data.child('game').child('assignments').exists() || data.child('hostAuthUid').val() == auth.uid || data.child('players').child(data.child('hostId').val()).child('authUid').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('hostId').val() == auth.uid && newData.child('players').child(auth.uid).child('authUid').val() == auth.uid && !newData.child('game').child('assignments').exists()) || (data.exists() && !newData.exists() && (data.child('hostAuthUid').val() == auth.uid || data.child('players').child(data.child('hostId').val()).child('authUid').val() == auth.uid)))",
        ".validate": "newData.hasChildren(['hostId','hostAuthUid','settings','players','game']) && newData.child('hostId').isString() && newData.child('hostAuthUid').isString() && newData.child('game').child('assignments').exists() == false",
        "hostId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.exists() && data.exists() && ((data.child('players').child(data.val()).child('authUid').val() == auth.uid && data.child('players').child(newData.val()).child('connected').val() == true && data.child('players').child(newData.val()).child('status').val() == 'online') || (data.child('players').child(data.val()).child('status').val() == 'offline' && data.child('players').child(data.val()).child('connected').val() != true && data.child('players').child(newData.val()).child('authUid').val() == auth.uid && data.child('players').child(newData.val()).child('connected').val() == true && data.child('players').child(newData.val()).child('status').val() == 'online'))",
          ".validate": "newData.isString() && data.parent().child('players').child(newData.val()).exists() && data.parent().child('players').child(newData.val()).child('connected').val() == true && data.parent().child('players').child(newData.val()).child('status').val() == 'online'"
        },
        "hostAuthUid": {
          ".read": "auth != null",
          ".write": "auth != null && ((data.parent().child('hostId').val() == data.parent().child('players').child(auth.uid).val() && newData.val() == auth.uid) || (data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == auth.uid && newData.val() == auth.uid))",
          ".validate": "newData.isString() && data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == newData.val()"
        },
        "hostName": {
          ".read": "auth != null",
          ".write": "auth != null && data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == auth.uid && data.parent().child('game').child('phase').val() == 'lobby'",
          ".validate": "newData.hasChildren(['categories','totalRounds']) && newData.child('categories').hasChildren() && newData.child('totalRounds').isNumber() && newData.child('totalRounds').val() >= 1 && newData.child('totalRounds').val() <= 20"
        },
        "metadata": {
          ".read": "auth != null",
          ".write": "auth != null && data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == auth.uid"
        },
        "players": {
          "$playerId": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('game').child('phase').val() == 'lobby' && (data.child('authUid').val() == auth.uid || (!data.exists() && $playerId == auth.uid && newData.child('authUid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['name','authUid','joinedAt','status','connected']) && newData.child('authUid').isString() && (data.exists() ? newData.child('authUid').val() == data.child('authUid').val() : newData.child('authUid').val() == auth.uid) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('status').isString() && (newData.child('status').val() == 'online' || newData.child('status').val() == 'offline') && newData.child('connected').isBoolean()",
            "accountUid": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid && data.parent().parent().child('game').child('phase').val() == 'lobby'",
              ".validate": "newData.val() == null || newData.val() == auth.uid"
            },
            "authUid": {
              ".read": "auth != null",
              ".write": "auth != null && ((data.exists() && data.val() == auth.uid) || (!data.exists() && newData.val() == auth.uid))"
            },
            "name": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid && data.parent().parent().child('game').child('phase').val() == 'lobby'"
            },
            "status": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid"
            },
            "connected": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid"
            },
            "lastSeen": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid"
            },
            "leftAt": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid"
            },
            "joinedAt": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid"
            },
            "reconnectedAt": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().child('authUid').val() == auth.uid"
            }
          }
        },
        "game": {
          ".read": "auth != null && (!data.parent().child('game').child('assignments').exists() || data.parent().child('hostAuthUid').val() == auth.uid || data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == auth.uid)",
          ".write": "auth != null && data.parent().child('players').child(data.parent().child('hostId').val()).child('authUid').val() == auth.uid",
          ".validate": "newData.hasChildren(['phase','round','currentRound','totalRounds','scores','playerNames','activePlayers']) && newData.child('assignments').exists() == false && newData.child('totalRounds').isNumber() && newData.child('totalRounds').val() >= 1 && newData.child('totalRounds').val() <= 20 && newData.child('round').isNumber() && newData.child('currentRound').isNumber() && newData.child('scores').exists()",
          "phase": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid"
          },
          "round": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "currentRound": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "scores": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid",
            "$playerId": {
              ".read": "auth != null",
              ".write": "auth != null && data.parent().parent().parent().child('players').child(data.parent().parent().parent().child('hostId').val()).child('authUid').val() == auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() == 0) || (data.val() == newData.val()) || (data.parent().parent().child('phase').val() == 'finished' && newData.parent().parent().child('phase').val() == 'lobby' && newData.val() == 0) || (data.parent().parent().child('phase').val() == 'scoring' && newData.parent().parent().child('phase').val() == 'results' && newData.parent().parent().child('roundResults').child('round').val() == data.parent().parent().child('currentRound').val() && newData.val() == data.val() + (newData.parent().parent().child('roundResults').child('places').child('first').child('playerId').val() == $playerId ? 3 : 0) + (newData.parent().parent().child('roundResults').child('places').child('second').child('playerId').val() == $playerId ? 2 : 0) + (newData.parent().parent().child('roundResults').child('places').child('third').child('playerId').val() == $playerId ? 1 : 0)))"
            }
          },
          "playerNames": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid"
          },
          "activePlayers": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid"
          },
          "roundResults": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid",
            ".validate": "newData.val() == null || (newData.hasChildren(['round','places']) && newData.child('round').val() == data.parent().child('currentRound').val() && newData.child('places').child('first').child('playerId').isString() && newData.child('places').child('second').child('playerId').isString() && newData.child('places').child('first').child('playerId').val() != newData.child('places').child('second').child('playerId').val())"
          },
          "assignmentState": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid",
            ".validate": "newData.val() == null || newData.val() == 'pending' || newData.val() == 'writing' || newData.val() == 'ready'"
          },
          "assignmentWriterId": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid"
          },
          "assignmentWriteStartedAt": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid"
          },
          "roundToken": {
            ".read": "auth != null",
            ".write": "auth != null && data.parent().parent().child('players').child(data.parent().parent().child('hostId').val()).child('authUid').val() == auth.uid"
          }
        }
      }
    },
    "privateAssignments": {
      "$roomId": {
        ".read": false,
        "$playerId": {
          ".read": "auth != null && root.child('roomMembers').child($roomId).child(auth.uid).val() == $playerId",
          ".write": "auth != null && (root.child('rooms').child($roomId).child('hostAuthUid').val() == auth.uid || root.child('rooms').child($roomId).child('players').child(root.child('rooms').child($roomId).child('hostId').val()).child('authUid').val() == auth.uid) && ((!newData.exists()) || root.child('rooms').child($roomId).child('game').child('assignmentState').val() == 'writing' || root.child('rooms').child($roomId).child('game').child('assignments').exists())",
          ".validate": "newData.hasChildren(['playerId','player','character','round']) && newData.child('playerId').val() == $playerId && newData.child('round').isNumber() && newData.child('round').val() == root.child('rooms').child($roomId).child('game').child('currentRound').val() && (root.child('rooms').child($roomId).child('game').child('assignments').exists() || root.child('rooms').child($roomId).child('game').child('activePlayers').child($playerId).val() == true) && newData.child('character').hasChildren(['nombre','imagen','categoria']) && newData.child('character').child('nombre').isString() && newData.child('character').child('categoria').isString() && newData.child('character').child('imagen').isString()"
        }
      }
    },
    "publicAssignments": {
      "$roomId": {
        ".read": false,
        ".write": "auth != null && (root.child('rooms').child($roomId).child('hostAuthUid').val() == auth.uid || root.child('rooms').child($roomId).child('players').child(root.child('rooms').child($roomId).child('hostId').val()).child('authUid').val() == auth.uid) && !newData.exists()"
      }
    },
    "roomMembers": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid && (!newData.exists() || root.child('rooms').child($roomId).child('players').child(newData.val()).child('authUid').val() == auth.uid)",
          ".validate": "newData.val() == null || newData.isString()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.child('username').isString() && newData.child('username').val().length >= 3 && newData.child('username').val().length <= 20"
      }
    },
    "publicUsers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.child('username').isString() && newData.child('usernameLower').isString()"
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && newData.val() == auth.uid) || (data.val() == auth.uid && !newData.exists()))",
        ".validate": "newData.val() == null || newData.val() == auth.uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $friendUid)",
          ".validate": "newData.val() == null || newData.val() == true"
        }
      }
    },
    "friendLinks": {
      "$pair": {
        ".read": "auth != null",
        ".write": "auth != null && ($pair.contains(auth.uid))",
        ".validate": "newData.val() == null || newData.val() == true"
      }
    },
    "friendRequests": {
      "sent": {
        "$from": {
          "$to": {
            ".read": "auth != null && (auth.uid == $from || auth.uid == $to)",
            ".write": "auth != null && (auth.uid == $from || auth.uid == $to)"
          }
        }
      },
      "received": {
        "$to": {
          "$from": {
            ".read": "auth != null && (auth.uid == $to || auth.uid == $from)",
            ".write": "auth != null && (auth.uid == $to || auth.uid == $from)"
          }
        }
      }
    },
    "roomInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$roomId": {
          ".write": "auth != null && ((auth.uid == $uid && !newData.exists()) || (newData.child('fromUid').val() == auth.uid && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()))",
          ".validate": "newData.val() == null || (newData.child('fromUid').val() == auth.uid && newData.child('roomCode').val() == $roomId)"
        }
      }
    }
  }
}
